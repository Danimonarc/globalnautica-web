# Solo aplica cuando la web se suba al hosting de globalnautica.com (Apache / IONOS).
# GitHub Pages ignora este archivo.
RewriteEngine On

# Forzar https://www.globalnautica.com (una sola versión de la web para Google)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.globalnautica\.com$ [NC]
RewriteRule ^(.*)$ https://www.globalnautica.com/$1 [R=301,L]

# Redirigir las URLs de la web antigua a sus equivalentes nuevas
# (NE evita que el "#" de los anclajes se codifique)
RewriteRule ^2\.html$ /#servicios [R=301,L,NE]
RewriteRule ^3\.html$ /servicios-tecnicos/ [R=301,L]
RewriteRule ^5\.html$ /fiscalidad-nautica/ [R=301,L]
RewriteRule ^9\.html$ /gestoria-nautica/ [R=301,L]
RewriteRule ^6\.html$ /#recursos [R=301,L,NE]
RewriteRule ^7\.html$ /#contacto [R=301,L,NE]
RewriteRule ^8\.html$ /aviso-legal/ [R=301,L]
RewriteRule ^aviso-legal\.html$ /aviso-legal/ [R=301,L]
